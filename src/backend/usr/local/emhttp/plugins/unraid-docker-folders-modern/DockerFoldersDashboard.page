Menu="Dashboard:0"
Markdown="false"
Cond="version_compare(parse_ini_file('/etc/unraid-version')['version'],'6.11.9','>') && is_file('/var/run/dockerd.pid')"
---
<?php
/*
 * Dashboard tile: a light folder view of the Docker containers.
 *
 * Unraid's dashboard (dynamix DashStats.page) echoes every $mytiles[<plugin>][columnN]
 * string into its column tables. The tile body is an iframe so the Vue widget keeps
 * its own CSS, away from Unraid's 62.5% root font size and global element styles.
 */
require_once '/usr/local/emhttp/plugins/unraid-docker-folders-modern/include/config.php';

if (!file_exists(DB_PATH)) return;

// Cache-busting stamps for the tile below. widget.html and frameSrc.js carry no
// content hash, so a plugin update does not reach the browser without them.
// They are computed here because a nowdoc cannot hold a PHP expression, and are
// substituted by str_replace after the string is built.
$frameSrcVersion = dfmAssetVersion(PLUGIN_DIR . '/include/frameSrc.js');
// Which backend the widget frame should use. See dfmBackendMode() in config.php.
$backendMode = dfmBackendMode();
$widgetVersion = dfmAssetVersion(PLUGIN_DIR . '/assets/widget.html');

// A nowdoc, not a heredoc: the inline JavaScript below uses jQuery's `$`, and a
// heredoc would interpolate it. The two dynamic values arrive as __DFM_*__
// placeholders and are replaced after this string, not interpolated into it.
// The title attribute is required. The dashboard md5-hashes it to key the saved
// tile position and collapse state, so renaming it resets both.
$tile = <<<'EOT'
<tbody id="docker_folders_view" title="Docker Folders">
<tr><td>
  <span class="tile-header">
    <span class="tile-header-left">
      <i class="icon-docker f32"></i>
      <div class="section">
        <h3 class="tile-header-main">Docker Folders</h3>
        <span class="flex flex-row flex-wrap items-center gap-4">
          <!-- The dashboard shows span.switch only while the tile is folded, the
               way the System tile shows its RAM bar. The widget frame sends the
               numbers, because it keeps running while its row is hidden. -->
          <span class="switch">
            <span class="dfm-summary">
              <span id="dfm-summary-count">-- running</span>
              <span class="dfm-summary-item">CPU <span class="dfm-summary-cpu">--</span><span class="dfm-summary-track"><span id="dfm-summary-cpu"></span></span></span>
              <span class="dfm-summary-item">RAM <span class="dfm-summary-memory">--</span><span class="dfm-summary-track"><span id="dfm-summary-memory"></span></span></span>
            </span>
          </span>
        </span>
      </div>
    </span>
    <span class="tile-header-right">
      <span class="tile-header-right-controls">
        <a href="/Docker/Folders" title="Go to Docker Folders"><i class="fa fa-fw fa-folder-open control"></i></a>
        <a href="#" id="docker-folders-widget-settings" title="Widget settings"><i class="fa fa-fw fa-cog control"></i></a>
      </span>
    </span>
  </span>
</td></tr>
<tr><td>
  <style>
    /* The folded-tile summary on one line. Unraid's own head_bar layout
       stacks one bar per line, so these are small inline bars in its colors.
       The header keeps the icon beside the title, and a narrow tile wraps
       the summary between items instead. */
    #docker_folders_view .tile-header-left { flex-wrap: nowrap; min-width: 0; }
    #docker_folders_view .tile-header-left .section { min-width: 0; }
    #docker_folders_view .dfm-summary { display: inline-flex; flex-wrap: wrap; align-items: center; column-gap: 12px; }
    #docker_folders_view .dfm-summary > span { white-space: nowrap; }
    #docker_folders_view .dfm-summary-item { display: inline-flex; align-items: center; gap: 5px; }
    #docker_folders_view .dfm-summary-track { position: relative; display: inline-block; width: 40px; height: 8px; background-color: var(--usage-disk-background-color); }
    #docker_folders_view .dfm-summary-track > span { position: absolute; left: 0; top: 0; bottom: 0; width: 0; background-color: var(--gray-400); }
  </style>
  <iframe id="docker-folders-widget-frame" scrolling="no" style="display:block;width:100%;height:40px;border:none;"></iframe>
  <script>window.dockerFoldersBackendMode = '__DFM_BACKEND__';</script>
  <script>window.dockerFoldersAssetVersion = '__DFM_WIDGET_V__';</script>
  <script src="/plugins/unraid-docker-folders-modern/include/frameSrc.js?v=__DFM_FRAMESRC_V__"></script>
  <script>
  (function() {
    // This tile replaces Unraid's own Docker tile. Remove it now, while the page
    // is still parsing: the dashboard's sortTables() and addProperties() run on
    // ready, so the tile never gets a sort slot or a spacer row. loadlist() then
    // appends to an empty jQuery set, which does nothing.
    var legacy = document.getElementById('docker_view');
    if (legacy && legacy.parentNode) legacy.parentNode.removeChild(legacy);

    var frame = document.getElementById('docker-folders-widget-frame');

    // The settings panel lives inside the frame, so the cog asks for it with a message.
    document.getElementById('docker-folders-widget-settings').addEventListener('click', function(e) {
      e.preventDefault();
      if (frame.contentWindow) frame.contentWindow.postMessage({ type: 'docker-folders-widget-settings' }, location.origin);
    });

    var frameRow = frame.closest('tr');

    // The folded-tile summary. Same load thresholds as the widget's own bars.
    function loadBar(name, percent) {
      var label = document.querySelector('.dfm-summary-' + name);
      var bar = document.getElementById('dfm-summary-' + name);
      if (typeof percent !== 'number') {
        label.textContent = '--';
        bar.style.width = '0';
        return;
      }
      var text = percent.toFixed(1) + '%';
      label.textContent = text;
      label.style.color = percent > 80 ? '#f0000c' : percent > 50 ? '#e68a00' : '#4f8a10';
      bar.className = percent > 80 ? 'redbar' : percent > 50 ? 'orangebar' : '';
      bar.style.width = Math.min(percent, 100) + '%';
    }

    window.addEventListener('message', function(e) {
      if (!e.data || typeof e.data !== 'object') return;
      if (e.source !== frame.contentWindow) return;
      if (e.data.type === 'docker-folders-resize') {
        frame.style.height = e.data.height + 'px';
      }
      if (e.data.type === 'docker-folders-widget-ready' && e.origin === location.origin) sendCollapsed();
      if (e.data.type === 'docker-folders-summary' && e.origin === location.origin) {
        document.getElementById('dfm-summary-count').textContent = e.data.running + ' / ' + e.data.total + ' running';
        loadBar('cpu', e.data.cpu);
        loadBar('memory', e.data.memory);
      }
    });

    // Folding the tile hides this row with an inline display:none, which is all
    // the dashboard's openClose() changes. Tell the frame, so it keeps
    // measuring stats for the header while its own rows are out of sight.
    function sendCollapsed() {
      if (!frame.contentWindow) return;
      frame.contentWindow.postMessage({ type: 'docker-folders-tile-collapsed', collapsed: frameRow.style.display === 'none' }, location.origin);
    }
    // The widget also asks once it has mounted (docker-folders-widget-ready).
    new MutationObserver(sendCollapsed).observe(frameRow, { attributes: true, attributeFilter: ['style'] });

    // Set src only after the dashboard sorts its tiles. sortTables() moves each
    // tile with appendTo, and moving an iframe reloads it, so an earlier src
    // would load the widget twice. The dashboard's own ready handler registers
    // later in the page than this one, so the timeout queues after it.
    $(function() { setTimeout(function() {
      frame.src = window.dockerFoldersFrameSrc('widget.html');
    }, 0); });
  })();
  </script>
</td></tr>
</tbody>
EOT;

$mytiles['unraid-docker-folders-modern']['column2'] = str_replace(
  ['__DFM_WIDGET_V__', '__DFM_FRAMESRC_V__', '__DFM_BACKEND__'],
  [$widgetVersion, $frameSrcVersion, $backendMode],
  $tile
);
?>
